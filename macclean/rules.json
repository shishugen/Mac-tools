{
  "version": "0.1.0",
  "note": "白名单规则。deny by default：不在此文件里的路径一律不会被清理。level: S=可重建 A=含用户数据 B=需管理员 C=红线只展示",
  "redlines": [
    "~/Library/Keychains",
    "~/Library/Preferences",
    "~/Library/Cookies",
    "~/Library/Application Support",
    "~/Library/Mail",
    "~/Library/Messages",
    "~/Library/Calendars",
    "~/Library/Contacts",
    "~/Library/Photos",
    "~/Library/Accounts",
    "~/Library/IdentityServices",
    "~/Documents",
    "~/Desktop",
    "~/Downloads",
    "~/.ssh",
    "~/.config",
    "~/.aws",
    "~/.gnupg",
    "~/.workbuddy",
    "/System",
    "/Library",
    "/usr",
    "/bin",
    "/sbin",
    "/private/etc",
    "/private/var",
    "/var"
  ],
  "rules": [
    {
      "id": "user-caches",
      "name": "用户应用缓存",
      "level": "S",
      "patterns": ["~/Library/Caches/*"],
      "exclude": ["*/CloudKit"],
      "rebuildable": true,
      "reason": "应用缓存，删除后下次使用时自动重建"
    },
    {
      "id": "sandbox-caches",
      "name": "沙盒应用缓存",
      "level": "S",
      "patterns": ["~/Library/Containers/*/Data/Library/Caches/*"],
      "rebuildable": true,
      "reason": "沙盒应用内部缓存，不涉及账号与文档"
    },
    {
      "id": "app-cache-subdirs",
      "name": "应用目录内的缓存子目录",
      "level": "S",
      "patterns": [
        "~/Library/Application Support/*/Cache",
        "~/Library/Application Support/*/Caches",
        "~/Library/Application Support/*/GPUCache",
        "~/Library/Application Support/*/Code Cache",
        "~/Library/Application Support/*/ShaderCache",
        "~/Library/Application Support/*/GrShaderCache",
        "~/Library/Application Support/*/DawnCache"
      ],
      "rebuildable": true,
      "reason": "明确命名为缓存的子目录，同目录下的配置与数据库不动"
    },
    {
      "id": "user-logs",
      "name": "应用日志（7 天前）",
      "level": "S",
      "patterns": ["~/Library/Logs/*"],
      "min_age_days": 7,
      "rebuildable": true,
      "reason": "超过 7 天的日志文件，排障时才需要"
    },
    {
      "id": "dot-cache",
      "name": "命令行工具缓存",
      "level": "S",
      "patterns": ["~/.cache/*"],
      "rebuildable": true,
      "reason": "各类 CLI 工具的下载与编译缓存"
    },
    {
      "id": "npm-cache",
      "name": "npm 缓存",
      "level": "S",
      "patterns": ["~/.npm/_cacache"],
      "rebuildable": true,
      "reason": "npm 包缓存，重装依赖时重新下载"
    },
    {
      "id": "gradle-cache",
      "name": "Gradle 缓存",
      "level": "S",
      "patterns": ["~/.gradle/caches"],
      "rebuildable": true,
      "reason": "Gradle 依赖缓存，重新构建时下载"
    },
    {
      "id": "go-cache",
      "name": "Go 模块缓存",
      "level": "S",
      "patterns": ["~/go/pkg/mod/cache"],
      "rebuildable": true,
      "reason": "Go 模块下载缓存"
    },
    {
      "id": "brew-cache",
      "name": "Homebrew 缓存",
      "level": "S",
      "patterns": ["~/Library/Caches/Homebrew", "~/Library/Caches/pip"],
      "rebuildable": true,
      "reason": "安装包与 pip 下载缓存"
    },
    {
      "id": "xcode-derived",
      "name": "Xcode 编译中间产物",
      "level": "S",
      "patterns": ["~/Library/Developer/Xcode/DerivedData/*"],
      "rebuildable": true,
      "reason": "编译缓存，下次编译自动重建（首次会变慢）"
    },
    {
      "id": "simulator-caches",
      "name": "模拟器缓存",
      "level": "S",
      "patterns": ["~/Library/Developer/CoreSimulator/Caches/*"],
      "rebuildable": true,
      "reason": "模拟器运行时缓存"
    },
    {
      "id": "ios-device-support",
      "name": "iOS 设备符号文件",
      "level": "A",
      "patterns": ["~/Library/Developer/Xcode/iOS DeviceSupport/*"],
      "rebuildable": true,
      "reason": "调试符号，连设备时会重新生成，旧版本可删"
    },
    {
      "id": "xcode-archives",
      "name": "Xcode 归档包",
      "level": "A",
      "patterns": ["~/Library/Developer/Xcode/Archives/*"],
      "rebuildable": false,
      "reason": "用于上架与崩溃符号还原，删了无法重新生成"
    },
    {
      "id": "ios-backup",
      "name": "iPhone / iPad 本地备份",
      "level": "A",
      "patterns": ["~/Library/Application Support/MobileSync/Backup/*"],
      "rebuildable": false,
      "reason": "设备备份，删除后无法从本机恢复"
    },
    {
      "id": "simulator-devices",
      "name": "模拟器设备数据",
      "level": "A",
      "patterns": ["~/Library/Developer/CoreSimulator/Devices/*"],
      "rebuildable": false,
      "reason": "含模拟器内 App 与登录态，需重新创建"
    },
    {
      "id": "mail-downloads",
      "name": "邮件附件缓存",
      "level": "A",
      "patterns": ["~/Library/Containers/com.apple.mail/Data/Library/Mail Downloads/*"],
      "rebuildable": true,
      "reason": "已下载的邮件附件副本，服务器上通常还有"
    },
    {
      "id": "trash",
      "name": "废纸篓",
      "level": "A",
      "patterns": ["~/.Trash/*"],
      "requires_flag": "include-trash",
      "rebuildable": false,
      "reason": "清空后无法恢复，仅在显式加 --include-trash 时出现"
    },
    {
      "id": "system-caches",
      "name": "系统级缓存",
      "level": "B",
      "patterns": ["/Library/Caches/*"],
      "needs_admin": true,
      "rebuildable": true,
      "reason": "所有用户共享的缓存，需要管理员权限"
    },
    {
      "id": "system-logs",
      "name": "系统级日志（7 天前）",
      "level": "B",
      "patterns": ["/Library/Logs/*"],
      "needs_admin": true,
      "min_age_days": 7,
      "rebuildable": true,
      "reason": "系统日志，需要管理员权限"
    }
  ]
}
