{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macclean",
  "version": "0.1.0",
  "identifier": "com.macclean.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "macclean",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "engine/api.py",
      "engine/macclean.py",
      "engine/rules.json",
      "engine/usage_tracker.py",
      "engine/container.py"
    ]
  }
}